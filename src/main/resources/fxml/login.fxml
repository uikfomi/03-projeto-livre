<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.salgaderia.app.controller.LoginController">
    <left>
        <VBox prefWidth="360" spacing="20" alignment="CENTER_LEFT" styleClass="brand-panel">
            <Label text="SALGADERIA PRO" styleClass="brand-name" />
            <Label text="Sabor que aproxima." wrapText="true" styleClass="brand-title" />
            <Label text="Seus pedidos e sua gestão em um só lugar." wrapText="true" styleClass="brand-description" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="CENTER" spacing="20" styleClass="page">
                    <VBox maxWidth="480" spacing="18" styleClass="card">
                        <Label text="Bem-vindo(a)!" styleClass="title" />
                        <Label text="Entre na sua conta ou faça seu cadastro." wrapText="true" styleClass="subtitle" />
                        <TabPane fx:id="abas" tabClosingPolicy="UNAVAILABLE">
                            <tabs>
                                <Tab text="Entrar">
                                    <content>
                                        <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
                                            <Label text="E-mail ou login" styleClass="field-label" />
                                            <TextField fx:id="login" promptText="Seu e-mail ou login" accessibleText="E-mail ou login" />
                                            <Label text="Senha" styleClass="field-label" />
                                            <PasswordField fx:id="senha" promptText="Sua senha" accessibleText="Senha" onAction="#entrar" />
                                            <TextField fx:id="senhaVisivel" promptText="Sua senha" accessibleText="Senha visível" onAction="#entrar" />
                                            <CheckBox fx:id="mostrarSenha" text="Mostrar senha" />
                                            <Button text="Entrar" maxWidth="Infinity" onAction="#entrar" styleClass="button-primary" />
                                        </VBox>
                                    </content>
                                </Tab>
                                <Tab text="Criar conta">
                                    <content>
                                        <VBox spacing="8" style="-fx-padding: 20 0 0 0;">
                                            <Label text="E-mail" styleClass="field-label" />
                                            <TextField fx:id="cadastroEmail" promptText="voce@exemplo.com" accessibleText="E-mail do cadastro" />
                                            <Label text="Senha" styleClass="field-label" />
                                            <PasswordField fx:id="cadastroSenha" promptText="Crie sua senha" accessibleText="Senha do cadastro" onAction="#cadastrar" />
                                            <Button text="Criar conta de cliente" maxWidth="Infinity" onAction="#cadastrar" styleClass="button-primary" />
                                        </VBox>
                                    </content>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
